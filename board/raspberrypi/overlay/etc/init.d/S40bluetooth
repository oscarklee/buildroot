#!/bin/sh

DAEMON="bluetoothd"
PIDFILE="/var/run/$DAEMON.pid"
CONTROLLER="8C:CD:E8:BA:D8:40"

start() {
    (
        echo "Starting Bluetooth (Background)..."
        modprobe hci_uart 2>/dev/null || true
        modprobe uhid 2>/dev/null || true
        
        if [ -e /proc/device-tree/soc/gpio@7e200000/bt_pins ]; then
            ( hciattach /dev/ttyAMA0 bcm43xx 921600 noflow - || true ) &
            sleep 3
        fi
        
        start-stop-daemon -S -q -b -m -p $PIDFILE -x /usr/libexec/bluetooth/bluetoothd -- --compat --experimental
        
        sleep 3
        bluetoothctl power on
        bluetoothctl pairable on
        bluetoothctl discoverable on
        
        # Reconnection Guardian using bluetoothctl only (no hcitool required)
        while true; do
            if ! bluetoothctl info $CONTROLLER 2>/dev/null | grep -q "Connected: yes"; then
                bluetoothctl connect $CONTROLLER >/dev/null 2>&1
            fi
            sleep 2
        done
    ) &
}

stop() {
    echo "Stopping Bluetooth..."
    bluetoothctl power off
    start-stop-daemon -K -q -p $PIDFILE
    killall hciattach 2>/dev/null
    pkill -f "bluetoothctl connect" 2>/dev/null
}

restart() {
    stop
    sleep 1
    start
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart|reload) restart ;;
    *) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
