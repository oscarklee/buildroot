#!/bin/sh

DAEMON="bluetoothd"
PIDFILE="/var/run/$DAEMON.pid"

start() {
    (
        echo "Starting Bluetooth (Background)..."
        modprobe hci_uart 2>/dev/null || true
        modprobe uhid 2>/dev/null || true
        
        if [ -e /proc/device-tree/soc/gpio@7e200000/bt_pins ]; then
            ( hciattach /dev/ttyAMA0 bcm43xx 921600 noflow - || true ) &
            sleep 3
        fi
        
        start-stop-daemon -S -q -b -m -p $PIDFILE -x /usr/libexec/bluetooth/bluetoothd -- --compat --experimental
        
        sleep 3
        bluetoothctl power on
        bluetoothctl pairable on
        bluetoothctl discoverable on
        
        # Page Scan estándar (más estable)
        hciconfig hci0 pscan
        
        # Guardian de reconexión estable (1.0s)
        while true; do
            if hcitool con | grep -q '8C:CD:E8:BA:D8:40'; then
                if ! bluetoothctl info 8C:CD:E8:BA:D8:40 | grep -q 'Connected: yes'; then
                    # Esperar 0.5s para que el mando termine su propio proceso interno
                    sleep 0.5
                    bluetoothctl connect 8C:CD:E8:BA:D8:40 >/dev/null 2>&1
                fi
            fi
            sleep 0.5
        done
    ) &
}

stop() {
    echo "Stopping Bluetooth..."
    bluetoothctl power off
    start-stop-daemon -K -q -p $PIDFILE
    killall hciattach 2>/dev/null
    pkill -f 'hcitool con' 2>/dev/null
}

restart() {
    stop
    sleep 1
    start
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart|reload) restart ;;
    *) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
