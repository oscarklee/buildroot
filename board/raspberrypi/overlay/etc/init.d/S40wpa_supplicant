#!/bin/sh

DAEMON="wpa_supplicant"
PIDFILE="/var/run/$DAEMON.pid"

WPA_SUPPLICANT_BIN=/usr/sbin/wpa_supplicant
WPA_SUPPLICANT_CONF=/etc/wpa_supplicant.conf

case "$1" in
    start)
        (
            printf "Starting $DAEMON (Background): "
            
            # Load brcmfmac driver
            modprobe brcmfmac
            
            # Wait for wlan0 interface (up to 20s for cold boot)
            for i in $(seq 1 20); do
                if ifconfig wlan0 > /dev/null 2>&1; then
                    break
                fi
                sleep 1
            done
            
            # Check if wlan0 exists
            if ! ifconfig wlan0 > /dev/null 2>&1; then
                echo "FAIL (wlan0 not found)"
                exit 1
            fi
            
            # Bring up wlan0
            ifconfig wlan0 up
            
            # Start wpa_supplicant
            start-stop-daemon -S -q -p $PIDFILE -x $WPA_SUPPLICANT_BIN -- \
                -B -P $PIDFILE -i wlan0 -c $WPA_SUPPLICANT_CONF -D nl80211,wext
            
            # Wait for connection and get IP via DHCP (retry up to 3 times)
            for attempt in 1 2 3; do
                sleep 5
                if udhcpc -i wlan0 -q -n -t 3 2>/dev/null; then
                    echo "OK"
                    exit 0
                fi
            done
            
            echo "FAIL (no DHCP)"
        ) &
        ;;
    stop)
        printf "Stopping $DAEMON: "
        start-stop-daemon -K -q -p $PIDFILE
        rm -f $PIDFILE
        echo "OK"
        ;;
    restart|reload)
        $0 stop
        $0 start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
esac

exit 0
