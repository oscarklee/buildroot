#!/bin/sh
#
# S01emulator - Launch Snes9x emulator with fast boot
#

case "$1" in
  start)
    printf "Starting Snes9x fast boot sequence...\n"
    
    # Mount essential filesystems
    mount -t proc proc /proc 2>/dev/null
    mount -t sysfs sysfs /sys 2>/dev/null
    mount -t tmpfs tmpfs /tmp 2>/dev/null
    mount -t tmpfs tmpfs /run 2>/dev/null
    
    # Initialize device nodes with mdev
    echo /sbin/mdev > /proc/sys/kernel/hotplug
    mdev -s
    
    # Load audio module
    modprobe snd_bcm2835 2>/dev/null
    
    # Set audio volume to 70%
    amixer sset PCM 70% unmute 2>/dev/null
    
    # Start background services script
    /etc/init.d/S02background start &
    
    # Small delay to ensure devices are ready
    sleep 0.3
    
    # Launch emulator (will replace this init script process)
    printf "Launching Snes9x emulator...\n"
    cd /root
    exec /usr/bin/snes9x
    ;;
    
  stop)
    printf "Stopping Snes9x...\n"
    killall snes9x 2>/dev/null
    ;;
    
  restart|reload)
    "$0" stop
    "$0" start
    ;;
    
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac

exit 0
